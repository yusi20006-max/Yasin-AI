# FeedBridge Secrets and Environment Overrides
# Copy this file to '.env' and fill in the values.

# Eitaa Publishing Token
FEEDBRIDGE_EITAA_TOKEN=your-eitaa-api-token-here

# AI Processing API Key
FEEDBRIDGE_AI_API_KEY=your-openai-or-other-ai-key-here

# Optional Environment Overrides
# FEEDBRIDGE_DATABASE_PATH=custom_feedbridge.db
# FEEDBRIDGE_AI_ENABLED=true
# FEEDBRIDGE_SCHEDULER_INTERVAL=60
